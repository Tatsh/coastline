{
  "dependencies": [
    {
      "host": true,
      "name": "argparse"
    },
    {
      "host": true,
      "name": "spdlog"
    },
    {
      "host": true,
      "name": "zlib"
    }
  ],
  "description": "Reconstructed source of the Nintendo 64 game Top Gear Rally.",
  "documentation": "https://coastline.readthedocs.org",
  "features": {
    "video": {
      "dependencies": [
        {
          "default-features": false,
          "features": ["avcodec", "avformat", "openh264", "swresample", "swscale"],
          "name": "ffmpeg"
        }
      ],
      "description": "Decode and encode optional intro movies with libav."
    },
    "sdl": {
      "dependencies": [
        "argparse",
        "boost-pfr",
        "bzip2",
        "drlibs",
        "fmt",
        {
          "features": [
            "tools"
          ],
          "host": true,
          "name": "glslang"
        },
        "libflac",
        "meshoptimizer",
        "nlohmann-json",
        {
          "default-features": false,
          "features": [
            "vulkan"
          ],
          "name": "sdl3"
        },
        {
          "default-features": false,
          "features": [
            "alsa",
            "wayland",
            "x11"
          ],
          "name": "sdl3",
          "platform": "linux"
        },
        {
          "host": true,
          "name": "spirv-cross"
        },
        "zlib"
      ],
      "description": "Build the stand-alone SDL game."
    }
  },
  "homepage": "https://tatsh.github.io/coastline/",
  "license": "MIT",
  "maintainers": [
    "Andrew Udvare <audvare@gmail.com>"
  ],
  "name": "coastline",
  "version": "0.0.2"
}
