{
  "dependencies": [
    {
      "host": true,
      "name": "argparse"
    },
    {
      "host": true,
      "name": "spdlog"
    },
    {
      "host": true,
      "name": "zlib"
    }
  ],
  "description": "Reconstructed source of the Nintendo 64 game Top Gear Rally.",
  "documentation": "https://coastline.readthedocs.org",
  "features": {
    "sdl": {
      "dependencies": [
        "argparse",
        "boost-pfr",
        "drlibs",
        "fmt",
        {
          "features": ["tools"],
          "host": true,
          "name": "glslang"
        },
        "libflac",
        "nlohmann-json",
        {
          "default-features": false,
          "features": ["vulkan"],
          "name": "sdl3"
        },
        {
          "default-features": false,
          "features": ["alsa", "wayland", "x11"],
          "name": "sdl3",
          "platform": "linux"
        },
        {
          "host": true,
          "name": "spirv-cross"
        },
        "zlib"
      ],
      "description": "Build the stand-alone SDL game."
    }
  },
  "homepage": "https://tatsh.github.io/coastline/",
  "license": "MIT",
  "maintainers": ["Andrew Udvare <audvare@gmail.com>"],
  "name": "coastline",
  "version": "0.0.0"
}
