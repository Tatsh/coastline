{
  "configurations": [
    {
      "cStandard": "gnu89",
      "compileCommands": "${workspaceFolder}/build/n64-us/compile_commands.json",
      "compilerArgs": [
        "-G0",
        "-ffreestanding",
        "-fno-pic",
        "-mabi=32",
        "-march=vr4300",
        "-mno-abicalls"
      ],
      "compilerPath": "mips64-libdragon-elf-gcc",
      "configurationProvider": "ms-vscode.cmake-tools",
      "defines": [
        "TGR_PLATFORM=1",
        "TGR_PLATFORM_N64=1",
        "TGR_PLATFORM_WIN=2",
        "TGR_REGION=1",
        "TGR_REGION_EU=3",
        "TGR_REGION_JP=2",
        "TGR_REGION_US=1",
        "TGR_RENDERER=1",
        "TGR_RENDERER_D3D=1",
        "TGR_RENDERER_GLIDE=2"
      ],
      "includePath": [
        "${workspaceFolder}/3rdparty/zlib-1.0.4",
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/libultra/include"
      ],
      "intelliSenseMode": "linux-gcc-x86",
      "name": "N64 (USA)"
    },
    {
      "cStandard": "c23",
      "compileCommands": "${workspaceFolder}/build/win-d3d/compile_commands.json",
      "compilerArgs": ["-m32"],
      "compilerPath": "/usr/lib/mingw64-toolchain/bin/x86_64-w64-mingw32-g++",
      "configurationProvider": "ms-vscode.cmake-tools",
      "cppStandard": "c++23",
      "defines": [
        "TGR_PLATFORM=2",
        "TGR_PLATFORM_N64=1",
        "TGR_PLATFORM_WIN=2",
        "TGR_REGION=1",
        "TGR_REGION_EU=3",
        "TGR_REGION_JP=2",
        "TGR_REGION_US=1",
        "TGR_RENDERER=1",
        "TGR_RENDERER_D3D=1",
        "TGR_RENDERER_GLIDE=2"
      ],
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/libultra/include",
        "/usr/lib/mingw64-toolchain/x86_64-w64-mingw32/include",
        "/usr/lib/mingw64-toolchain/lib/gcc/x86_64-w64-mingw32/16/include/"
      ],
      "intelliSenseMode": "windows-gcc-x86",
      "name": "Windows (Direct3D)"
    },
    {
      "cStandard": "c23",
      "compileCommands": "${workspaceFolder}/build/win-glide/compile_commands.json",
      "compilerArgs": ["-m32"],
      "compilerPath": "/usr/lib/mingw64-toolchain/bin/x86_64-w64-mingw32-g++",
      "configurationProvider": "ms-vscode.cmake-tools",
      "cppStandard": "c++23",
      "defines": [
        "TGR_PLATFORM=2",
        "TGR_PLATFORM_N64=1",
        "TGR_PLATFORM_WIN=2",
        "TGR_REGION=1",
        "TGR_REGION_EU=3",
        "TGR_REGION_JP=2",
        "TGR_REGION_US=1",
        "TGR_RENDERER=2",
        "TGR_RENDERER_D3D=1",
        "TGR_RENDERER_GLIDE=2"
      ],
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/libultra/include",
        "/usr/lib/mingw64-toolchain/x86_64-w64-mingw32/include",
        "/usr/lib/mingw64-toolchain/lib/gcc/x86_64-w64-mingw32/16/include/"
      ],
      "intelliSenseMode": "windows-gcc-x86",
      "name": "Windows (Glide)"
    },
    {
      "cStandard": "c23",
      "compileCommands": "${workspaceFolder}/build/sdl/compile_commands.json",
      "compilerPath": "/usr/bin/g++",
      "configurationProvider": "ms-vscode.cmake-tools",
      "cppStandard": "c++23",
      "defines": [
        "ENABLE_PATCHES",
        "TGR_BOSS_RALLY=1",
        "TGR_PLATFORM=3",
        "TGR_PLATFORM_N64=1",
        "TGR_PLATFORM_SDL=3",
        "TGR_PLATFORM_WIN=2",
        "TGR_REGION=1",
        "TGR_REGION_EU=3",
        "TGR_REGION_JP=2",
        "TGR_REGION_US=1",
        "TGR_RENDERER=3",
        "TGR_RENDERER_D3D=1",
        "TGR_RENDERER_GLIDE=2",
        "TGR_RENDERER_SDL=3"
      ],
      "includePath": [
        "${workspaceFolder}/build/sdl/src/sdl",
        "${workspaceFolder}/build/sdl/src/sdl/generated",
        "${workspaceFolder}/build/sdl/vcpkg_installed/x64-linux/include",
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/libultra/include",
        "${workspaceFolder}/src/sdl",
        "${workspaceFolder}/tools/common"
      ],
      "intelliSenseMode": "linux-gcc-x64",
      "name": "SDL"
    }
  ],
  "env": {},
  "version": 4
}
