option(COASTLINE_INSTALL_ASSETS "Import and install assets, without setup or reset support." OFF)
set(COASTLINE_DISC_IMAGE "" CACHE FILEPATH "Boss Rally disc image for installed assets.")
set(COASTLINE_ROM_IMAGES "" CACHE STRING "Top Gear Rally ROM images, separated by semicolons.")
set(COASTLINE_ASSET_IMPORTER "" CACHE FILEPATH "Host coastline executable for cross-build imports.")

if(COASTLINE_INSTALL_ASSETS)
  if(NOT COASTLINE_DISC_IMAGE OR NOT COASTLINE_ROM_IMAGES)
    message(FATAL_ERROR "COASTLINE_INSTALL_ASSETS requires COASTLINE_DISC_IMAGE and COASTLINE_ROM_IMAGES.")
  endif()
  foreach(_image IN ITEMS "${COASTLINE_DISC_IMAGE}" ${COASTLINE_ROM_IMAGES})
    if(NOT IS_ABSOLUTE "${_image}" OR NOT EXISTS "${_image}" OR IS_DIRECTORY "${_image}")
      message(FATAL_ERROR "Asset image ${_image} must be an existing absolute file path.")
    endif()
  endforeach()
  if(CMAKE_CROSSCOMPILING AND NOT COASTLINE_ASSET_IMPORTER AND NOT CMAKE_CROSSCOMPILING_EMULATOR)
    message(FATAL_ERROR "Cross-build asset imports require COASTLINE_ASSET_IMPORTER or CMAKE_CROSSCOMPILING_EMULATOR.")
  endif()
endif()

function(coastline_install_assets target)
  if(NOT COASTLINE_INSTALL_ASSETS)
    return()
  endif()
  set(_data "${CMAKE_CURRENT_BINARY_DIR}/imported-assets/$<CONFIG>/coastline")
  set(_stamp "${CMAKE_CURRENT_BINARY_DIR}/imported-assets/$<CONFIG>/complete")
  set(_configuration "${CMAKE_CURRENT_BINARY_DIR}/imported-assets/$<CONFIG>/inputs")
  file(GENERATE OUTPUT "${_configuration}"
       CONTENT "${COASTLINE_DISC_IMAGE}\n${COASTLINE_ROM_IMAGES}\n${COASTLINE_ASSET_IMPORTER}\n")
  set(_inputs "${COASTLINE_DISC_IMAGE}" ${COASTLINE_ROM_IMAGES})
  get_filename_component(_disc_directory "${COASTLINE_DISC_IMAGE}" DIRECTORY)
  get_filename_component(_extension "${COASTLINE_DISC_IMAGE}" EXT)
  string(TOLOWER "${_extension}" _extension)
  if(_extension STREQUAL ".cue")
    set(_cues "${COASTLINE_DISC_IMAGE}")
  elseif(_extension STREQUAL ".bin")
    file(GLOB _cues CONFIGURE_DEPENDS "${_disc_directory}/*.[cC][uU][eE]")
  else()
    set(_cues)
  endif()
  foreach(_cue IN LISTS _cues)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_cue}")
    list(APPEND _inputs "${_cue}")
    file(STRINGS "${_cue}" _files REGEX "^[ \t]*FILE[ \t]+")
    foreach(_file IN LISTS _files)
      if(_file MATCHES "^[ \t]*FILE[ \t]+\"([^\"]+)\"")
        set(_file "${CMAKE_MATCH_1}")
      elseif(_file MATCHES "^[ \t]*FILE[ \t]+([^ \t]+)")
        set(_file "${CMAKE_MATCH_1}")
      else()
        continue()
      endif()
      cmake_path(ABSOLUTE_PATH _file BASE_DIRECTORY "${_disc_directory}" NORMALIZE)
      list(APPEND _inputs "${_file}")
    endforeach()
  endforeach()
  if(COASTLINE_ASSET_IMPORTER)
    set(_importer "${COASTLINE_ASSET_IMPORTER}")
    list(APPEND _inputs "${COASTLINE_ASSET_IMPORTER}")
  else()
    set(_importer ${CMAKE_CROSSCOMPILING_EMULATOR} "$<TARGET_FILE:${target}>")
  endif()
  set(_rom_arguments)
  foreach(_rom IN LISTS COASTLINE_ROM_IMAGES)
    list(APPEND _rom_arguments --rom "${_rom}")
  endforeach()
  add_custom_command(
    OUTPUT "${_stamp}"
    COMMAND "${CMAKE_COMMAND}" -E rm -f "${_stamp}"
    COMMAND "${CMAKE_COMMAND}" -E rm -rf "${_data}"
    COMMAND ${_importer} --data-dir "${_data}" import --cd "${COASTLINE_DISC_IMAGE}" ${_rom_arguments}
    COMMAND "${CMAKE_COMMAND}" -E touch "${_stamp}"
    DEPENDS ${target} ${_inputs} "${_configuration}"
    COMMENT "Importing Coastline assets for installation"
    VERBATIM)
  add_custom_target(coastline_assets ALL DEPENDS "${_stamp}")
  if(WIN32)
    add_custom_command(TARGET ${target} POST_BUILD
      COMMAND "${CMAKE_COMMAND}" "-DFILES=$<TARGET_RUNTIME_DLLS:${target}>"
              "-DDESTINATION=$<TARGET_FILE_DIR:${target}>"
              -P "${CMAKE_SOURCE_DIR}/cmake/copy-runtime.cmake"
      VERBATIM)
  endif()
  if(APPLE)
    set(_destination "Coastline.app/Contents/Resources/coastline")
  else()
    set(_destination "${CMAKE_INSTALL_DATADIR}/coastline")
  endif()
  install(CODE "if(NOT EXISTS \"${_stamp}\")\n  message(FATAL_ERROR \"Build coastline_assets before installing.\")\nendif()")
  install(DIRECTORY "${_data}/" DESTINATION "${_destination}")
endfunction()
