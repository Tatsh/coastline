{
  "buildPresets": [
    { "configurePreset": "boss-rally", "name": "boss-rally" },
    { "configurePreset": "coastline", "name": "coastline" },
    { "configurePreset": "tgr-us", "name": "tgr-us" },
    { "configurePreset": "tgr-jp", "name": "tgr-jp" },
    { "configurePreset": "tgr-eu", "name": "tgr-eu" },
    { "configurePreset": "tgr-asia", "name": "tgr-asia" }
  ],
  "configurePresets": [
    {
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      },
      "generator": "Ninja",
      "hidden": true,
      "name": "vcpkg"
    },
    {
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" },
      "generator": "Ninja",
      "hidden": true,
      "name": "base"
    },
    {
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/n64-toolchain.cmake",
        "TGR_PLATFORM": "n64"
      },
      "hidden": true,
      "inherits": "base",
      "name": "n64"
    },
    {
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/win-toolchain.cmake",
        "TGR_PLATFORM": "win"
      },
      "hidden": true,
      "inherits": "base",
      "name": "win"
    },
    {
      "cacheVariables": { "TGR_VARIANTS": "boss-rally" },
      "inherits": "win",
      "name": "boss-rally"
    },
    {
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_POLICY_DEFAULT_CMP0174": "NEW",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "TGR_ENABLE_PATCHES": "ON",
        "TGR_PLATFORM": "sdl",
        "VCPKG_MANIFEST_FEATURES": "sdl"
      },
      "inherits": "base",
      "name": "coastline"
    },
    { "cacheVariables": { "TGR_REGION": "us" }, "inherits": "n64", "name": "tgr-us" },
    { "cacheVariables": { "TGR_REGION": "jp" }, "inherits": "n64", "name": "tgr-jp" },
    { "cacheVariables": { "TGR_REGION": "eu" }, "inherits": "n64", "name": "tgr-eu" },
    { "cacheVariables": { "TGR_REGION": "asia" }, "inherits": "n64", "name": "tgr-asia" }
  ],
  "version": 6,
  "workflowPresets": [
    {
      "name": "boss-rally",
      "steps": [
        { "name": "boss-rally", "type": "configure" },
        { "name": "boss-rally", "type": "build" }
      ]
    },
    {
      "name": "coastline",
      "steps": [
        { "name": "coastline", "type": "configure" },
        { "name": "coastline", "type": "build" }
      ]
    },
    {
      "name": "tgr-us",
      "steps": [
        { "name": "tgr-us", "type": "configure" },
        { "name": "tgr-us", "type": "build" }
      ]
    },
    {
      "name": "tgr-jp",
      "steps": [
        { "name": "tgr-jp", "type": "configure" },
        { "name": "tgr-jp", "type": "build" }
      ]
    },
    {
      "name": "tgr-eu",
      "steps": [
        { "name": "tgr-eu", "type": "configure" },
        { "name": "tgr-eu", "type": "build" }
      ]
    },
    {
      "name": "tgr-asia",
      "steps": [
        { "name": "tgr-asia", "type": "configure" },
        { "name": "tgr-asia", "type": "build" }
      ]
    }
  ]
}
