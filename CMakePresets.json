{
  "buildPresets": [
    {
      "configurePreset": "n64-us",
      "name": "n64-us"
    },
    {
      "configurePreset": "n64-jp",
      "name": "n64-jp"
    },
    {
      "configurePreset": "n64-eu",
      "name": "n64-eu"
    },
    {
      "configurePreset": "win-d3d",
      "name": "win-d3d"
    },
    {
      "configurePreset": "win-glide",
      "name": "win-glide"
    },
    {
      "configurePreset": "all",
      "name": "all"
    },
    {
      "configurePreset": "tests",
      "name": "tests"
    }
  ],
  "configurePresets": [
    {
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      },
      "generator": "Ninja",
      "hidden": true,
      "name": "vcpkg"
    },
    {
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "generator": "Ninja",
      "hidden": true,
      "name": "base"
    },
    {
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/n64-toolchain.cmake",
        "TGR_PLATFORM": "n64"
      },
      "hidden": true,
      "inherits": "base",
      "name": "n64"
    },
    {
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/win-toolchain.cmake",
        "TGR_PLATFORM": "win"
      },
      "hidden": true,
      "inherits": "base",
      "name": "win"
    },
    {
      "cacheVariables": {
        "TGR_REGION": "us"
      },
      "inherits": "n64",
      "name": "n64-us"
    },
    {
      "cacheVariables": {
        "TGR_REGION": "jp"
      },
      "inherits": "n64",
      "name": "n64-jp"
    },
    {
      "cacheVariables": {
        "TGR_REGION": "eu"
      },
      "inherits": "n64",
      "name": "n64-eu"
    },
    {
      "cacheVariables": {
        "TGR_RENDERER": "d3d"
      },
      "inherits": "win",
      "name": "win-d3d"
    },
    {
      "cacheVariables": {
        "TGR_RENDERER": "glide"
      },
      "inherits": "win",
      "name": "win-glide"
    },
    {
      "cacheVariables": {
        "TGR_VARIANTS": "all"
      },
      "inherits": "base",
      "name": "all"
    },
    {
      "cacheVariables": {
        "TGR_TESTS": "ON"
      },
      "inherits": "base",
      "name": "tests"
    }
  ],
  "testPresets": [
    {
      "configurePreset": "tests",
      "name": "tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "version": 6,
  "workflowPresets": [
    {
      "name": "n64-us",
      "steps": [
        {
          "name": "n64-us",
          "type": "configure"
        },
        {
          "name": "n64-us",
          "type": "build"
        }
      ]
    },
    {
      "name": "n64-jp",
      "steps": [
        {
          "name": "n64-jp",
          "type": "configure"
        },
        {
          "name": "n64-jp",
          "type": "build"
        }
      ]
    },
    {
      "name": "n64-eu",
      "steps": [
        {
          "name": "n64-eu",
          "type": "configure"
        },
        {
          "name": "n64-eu",
          "type": "build"
        }
      ]
    },
    {
      "name": "win-d3d",
      "steps": [
        {
          "name": "win-d3d",
          "type": "configure"
        },
        {
          "name": "win-d3d",
          "type": "build"
        }
      ]
    },
    {
      "name": "win-glide",
      "steps": [
        {
          "name": "win-glide",
          "type": "configure"
        },
        {
          "name": "win-glide",
          "type": "build"
        }
      ]
    },
    {
      "name": "all",
      "steps": [
        {
          "name": "all",
          "type": "configure"
        },
        {
          "name": "all",
          "type": "build"
        }
      ]
    },
    {
      "name": "tests",
      "steps": [
        {
          "name": "tests",
          "type": "configure"
        },
        {
          "name": "tests",
          "type": "build"
        },
        {
          "name": "tests",
          "type": "test"
        }
      ]
    }
  ]
}
