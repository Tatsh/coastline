#include <windows.h>

1 VERSIONINFO
FILEVERSION @COASTLINE_METADATA_VERSION_MAJOR@,
            @COASTLINE_METADATA_VERSION_MINOR@,
            @COASTLINE_METADATA_VERSION_PATCH@,0
PRODUCTVERSION @COASTLINE_METADATA_VERSION_MAJOR@,
               @COASTLINE_METADATA_VERSION_MINOR@,
               @COASTLINE_METADATA_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE @COASTLINE_WIN_FILE_TYPE@
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Reconstruction by Tatsh. https://github.com/Tatsh/coastline.\0"
            VALUE "CompanyName", "@COASTLINE_WIN_COMPANY@\0"
            VALUE "FileDescription", "@COASTLINE_WIN_DESCRIPTION@\0"
            VALUE "FileVersion", "@COASTLINE_WIN_VERSION@\0"
            VALUE "InternalName", "@COASTLINE_WIN_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "@COASTLINE_WIN_COPYRIGHT@\0"
            VALUE "OriginalFilename", "@COASTLINE_WIN_FILENAME@\0"
            VALUE "ProductName", "@COASTLINE_WIN_PRODUCT@\0"
            VALUE "ProductVersion", "@COASTLINE_WIN_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
